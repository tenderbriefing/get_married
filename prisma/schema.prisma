generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  status         String    @default("active")
  country        String    @default("ZA")
  locale         String    @default("en-ZA")
  ageVerifiedAt  DateTime?
  consentVersion String?
  consentAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  profile              Profile?
  sessions             Session[]
  assessmentSessions   AssessmentSession[]
  swipesFrom           Swipe[]             @relation("SwipeFrom")
  swipesTo             Swipe[]             @relation("SwipeTo")
  matchesAsA           Match[]             @relation("MatchA")
  matchesAsB           Match[]             @relation("MatchB")
  messages             Message[]
  blocksReported       BlockReport[]       @relation("Reporter")
  blocksTargeted       BlockReport[]       @relation("Target")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id              String    @id @default(cuid())
  userId          String    @unique
  displayName     String
  birthYear       Int
  bio             String    @default("")
  intent          String    @default("either") // dating | friendship | either
  gender          String    @default("unspecified")
  seeking         String    @default("everyone") // comma-separated or everyone
  city            String    @default("Cape Town")
  radiusKm        Int       @default(50)
  dealbreakersJson String   @default("{}")
  photoUrl        String?
  discoveryReadyAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AssessmentInstrument {
  id        String   @id @default(cuid())
  version   String
  name      String
  itemsJson String
  createdAt DateTime @default(now())
  sessions  AssessmentSession[]
}

model AssessmentSession {
  id            String   @id @default(cuid())
  userId        String
  instrumentId  String
  status        String   @default("in_progress") // in_progress | complete | invalid
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  validityScore Float    @default(1)
  traitVectorJson String @default("{}")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument    AssessmentInstrument @relation(fields: [instrumentId], references: [id])
  responses     AssessmentResponse[]
}

model AssessmentResponse {
  id        String   @id @default(cuid())
  sessionId String
  itemId    String
  value     Int
  answeredAt DateTime @default(now())
  latencyMs Int      @default(0)
  session   AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, itemId])
}

model Swipe {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  action     String // like | pass
  createdAt  DateTime @default(now())
  fromUser   User     @relation("SwipeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("SwipeTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
}

model Match {
  id               String    @id @default(cuid())
  userAId          String
  userBId          String
  score            Float
  facetsJson       String    @default("[]")
  matchedAt        DateTime  @default(now())
  photoUnlockedAt  DateTime?
  userA            User      @relation("MatchA", fields: [userAId], references: [id], onDelete: Cascade)
  userB            User      @relation("MatchB", fields: [userBId], references: [id], onDelete: Cascade)
  conversation     Conversation?

  @@unique([userAId, userBId])
}

model Conversation {
  id        String    @id @default(cuid())
  matchId   String    @unique
  createdAt DateTime  @default(now())
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  moderatedFlag  Boolean  @default(false)
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model BlockReport {
  id         String   @id @default(cuid())
  reporterId String
  targetId   String
  reason     String
  status     String   @default("open")
  createdAt  DateTime @default(now())
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  target     User     @relation("Target", fields: [targetId], references: [id], onDelete: Cascade)
}
