# Legacy local SQLite (optional offline fallback / prisma scripts)
DATABASE_URL="file:./dev.db"

# Firebase web client config (Project settings → Your apps → Web)
# Console: https://console.firebase.google.com/project/resona123/settings/general
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="resona123.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="resona123"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="resona123.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_APP_ID"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXX"

# Firebase Admin (server) — never commit the JSON key
# Path to a service account key for project resona123
FIREBASE_SERVICE_ACCOUNT_PATH="./secrets/resona123-admin.json"
# Or paste the full JSON as a single line (escaped newlines in private_key):
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
FIREBASE_ADMIN_PROJECT_ID="resona123"
