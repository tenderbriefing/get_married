rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function matchMember(data) {
      return signedIn() && (request.auth.uid == data.userAId || request.auth.uid == data.userBId);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isSelf(userId);
      allow update, delete: if isSelf(userId);

      match /profile/{docId} {
        allow read: if signedIn();
        allow write: if isSelf(userId);
      }
    }

    match /assessmentInstruments/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /assessmentSessions/{sessionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;

      match /responses/{itemId} {
        allow read, write: if signedIn() && get(/databases/$(database)/documents/assessmentSessions/$(sessionId)).data.userId == request.auth.uid;
      }
    }

    match /likes/{likeId} {
      allow read: if signedIn() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.action in ['like', 'pass'];
      allow update: if signedIn() && resource.data.fromUserId == request.auth.uid;
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if matchMember(resource.data);
      allow create: if signedIn() && matchMember(request.resource.data);
      allow update: if matchMember(resource.data);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if matchMember(get(/databases/$(database)/documents/matches/$(matchId)).data);
        allow create: if matchMember(get(/databases/$(database)/documents/matches/$(matchId)).data)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000;
        allow update, delete: if false;
      }
    }

    match /blocks/{blockId} {
      allow read: if signedIn() && (resource.data.reporterId == request.auth.uid || resource.data.targetId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
